# ── Telegram (MTProto / Telethon) ─────────────────────────────────────────────
# Get from https://my.telegram.org → API Development Tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_PHONE=+14155550123
TELEGRAM_SESSION=harvest_session

# ── LLM ───────────────────────────────────────────────────────────────────────
# Backend: "litellm" (cloud API) or "local" (RyzenAI NPU/GPU/CPU via interlock)
LLM_BACKEND=litellm
#
# -- litellm backend --
# Model in litellm format: gpt-4o-mini, anthropic/claude-3.5-haiku, etc.
# DEFAULT since 2026-08-13 is a local 8B served on the mesh. Measured against
# gpt-5.6-luna over identical batches: 90% of its events, none invented, every
# field filled better, half the latency. See
# docs/03 - Architecture/11 - Training & Evaluation.md
LLM_MODEL=qwen3-8b
# Where it is served. Empty = the provider's own endpoint, which is what a
# bare gpt-4o-mini wants. Set this to point at a litellm proxy, Ollama, vLLM
# or LM Studio; anything OpenAI-compatible works with no code change.
LLM_API_BASE=https://central-dev.lan:4000/v1
# The proxy's own virtual key — NOT a provider key. Falls back to
# OPENAI_API_KEY when unset, so a plain cloud setup still works untouched.
LLM_API_KEY=sk-...
# The mesh proxy serves a self-signed certificate. Only turn this off for an
# endpoint you control.
LLM_VERIFY_SSL=false
#
# -- fallback --
# The primary is one box on one network. When it is down, out of context, or
# restarting, the harvest degrades to this instead of producing zero events —
# which is what happened on 2026-08-12, and the empty result then overwrote a
# cache holding 251. Every fallback is logged at ERROR. Empty disables it.
LLM_FALLBACK_MODEL=codex_sdk/gpt-5.6-luna
# Defaults to LLM_ZT_KEY, then to LLM_API_BASE, so on the mesh both sides
# usually need nothing more than the model name above.
# LLM_FALLBACK_API_KEY=sk-...
# LLM_FALLBACK_API_BASE=https://central-dev.lan:4000/v1
#
# Messages per extraction call. 5 is the default and is load-bearing for
# qwen3-8b, which is served with a 2048-token context: at 10 the largest
# batches overflow it and are refused outright. Measured: at 10, 6 of 15
# batches were rejected and they held 51 of 78 events. Raising the server's
# n_ctx to 8192 would let you go back to 10.
# LLM_BATCH_SIZE=5
#
# Set the API key for your chosen provider (used when LLM_API_KEY is unset):
OPENAI_API_KEY=sk-...
# Or for Anthropic: ANTHROPIC_API_KEY=sk-ant-...
# Or for OpenRouter: OPENROUTER_API_KEY=sk-or-v1-...
#
# -- local backend (requires ryzenai-python on PATH) --
# LLM_BACKEND=local
# LLM_MODEL_PATH=models/qwen2.5-7b-int4.onnx
# LLM_TOKENIZER_PATH=models/qwen2.5-7b-int4
# LLM_DEVICE=npu  # npu, gpu, or cpu

# ── TickTick ───────────────────────────────────────────────────────────────────
# 1. Go to https://developer.ticktick.com → Manage Apps → + App Name
# 2. Set OAuth Redirect URL to: http://127.0.0.1:8080
# 3. Copy Client ID and Client Secret below
TICKTICK_CLIENT_ID=your_client_id
TICKTICK_CLIENT_SECRET=your_client_secret
TICKTICK_REDIRECT_URI=http://127.0.0.1:8080
# Your normal TickTick login credentials
TICKTICK_USERNAME=you@example.com
TICKTICK_PASSWORD=yourpassword
# Optional: name of the TickTick project to create tasks in (uses Inbox if blank)
TICKTICK_PROJECT=

# ── Discord ───────────────────────────────────────────────────────────────────
# The desktop HTTP cache stopped holding message JSON (measured 2026-08-16:
# 0 of 4,257 entries were /channels/{id}/messages). This override still
# points the legacy cache reader, but it finds nothing on a current client.
# DISCORD_CACHE_PATH=
#
# Guild SCHEDULED EVENTS are the live Discord path. They come from the
# BetterDiscord plugin in integrations/discord-betterdiscord-plugin/, which
# writes a local file this reads. Default location is
#   %APPDATA%\discord-harvester\scheduled-events.json  (Windows)
#   ~/.config/discord-harvester/scheduled-events.json    (else)
# Set this only if you moved it. The plugin needs no config on this side.
# DISCORD_EVENTS_EXPORT=

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Option A: base64-encoded JSON (preferred — no loose files)
#   python -c "import base64; print(base64.b64encode(open('credentials.json').read().encode()).decode())"
# GMAIL_CREDENTIALS_JSON=eyJ...
# GMAIL_TOKEN_JSON=eyJ...
#
# Option B: file paths (fallback)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
#
# Tokens are tried in order — GMAIL_TOKEN_JSON, then GMAIL_TOKEN_FILE — and each
# is tried to completion, refresh included, before the next. If you keep both,
# re-export the env copy when it goes stale: a dead one still costs a failed
# round-trip and a warning on every Gmail call.
#
# Extra search terms, ANDed with the after: filter derived from --days-back.
# Leave empty unless you mean it. A newer_than: here overrides --days-back.
# GMAIL_QUERY=
# GMAIL_MAX_RESULTS=200
#
# The one-time OAuth consent flow opens a browser and blocks. It runs only with
# an attached terminal; set this to force it anywhere else (it will hang if
# nobody is there to click).
# GMAIL_OAUTH_INTERACTIVE=1
#
# ── Event extraction from mail (added 2026-08-10) ─────────────────────────────
# Gmail's snippet is capped at 200 chars; the median body is ~2500, so without
# this the pipeline reads ~8% of each email and the reranker drops most of it
# for having no date. Costs one extra API call per message. Set 0 to disable.
# GMAIL_FETCH_BODIES=1
# GMAIL_BODY_MAX_CHARS=5000
#
# Drop mail you have already read. Off for harvesting -- an invite you opened is
# still an invite, and this was discarding 42% of the mailbox. Set 1 for the
# older "unread only" behaviour.
# GMAIL_DROP_READ=1
#
# Follow event links (Luma, Eventbrite, ...) found in a body and read the page's
# schema.org JSON-LD -- exact date, time and venue, no browser. Measured: 12 of
# 14 links answered. Fetches are pooled and deduplicated across the harvest.
# GMAIL_EXPAND_LINKS=1
# GMAIL_EXPAND_MAX=40
#
# Label applied to mail that produced an event. This WRITES to your mailbox --
# additively: it adds a label, never archives and never removes one. Set empty
# to disable. --dry-run always skips it.
# GMAIL_EVENTS_LABEL=events

# ── Telegram filtering ────────────────────────────────────────────────────────
# Optional: comma-separated allowlist/blocklist of dialog names
# TELEGRAM_CHANNELS=work-chat,project-updates
# TELEGRAM_EXCLUDE=memes,random

# ── Obsidian output ───────────────────────────────────────────────────────────
# Directories for Obsidian-compatible markdown reports (date-stamped per run)
# OBSIDIAN_EVENTS_DIR=F:\path\to\vault\08 - Events Pool
# OBSIDIAN_RECRUITERS_DIR=F:\path\to\vault\08 - Events Pool\Recruiters

# ── MCP dispatch gateway ──────────────────────────────────────────────────────
# The gateway is the single MCP endpoint (default http://127.0.0.1:9000/mcp)
# that fronts the backend at EH_MCP_URL. It is the URL a remote custom
# connector points at, so it is the only part of this system meant to face
# outward — and the auth setting below is what makes that safe.
#
# EH_MCP_URL=http://127.0.0.1:8765/mcp
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=9000
# EH_GATEWAY_PATH=/mcp
#
# none | token | jwt | github | google | auth0 | workos | descope | clerk |
# azure | discord.  The gateway REFUSES to bind a non-loopback address while
# this is `none`, because the tools behind it harvest, spend LLM tokens, write
# to TickTick and drive a logged-in browser session.
# EH_GATEWAY_AUTH=none
#
# auth=token — a static bearer token. Fine for your own clients over a tunnel;
# a Claude custom connector CANNOT use it, because that flow is OAuth.
# EH_GATEWAY_TOKEN=
#
# auth=jwt — verify tokens you mint elsewhere. One of these two is required.
# EH_GATEWAY_JWT_SECRET=
# EH_GATEWAY_JWKS_URI=
# EH_GATEWAY_JWT_ISSUER=
# EH_GATEWAY_JWT_AUDIENCE=
#
# auth=<oauth provider> — the mode a Claude custom connector needs. All three
# are required. PUBLIC_URL is the https:// URL Claude actually reaches (your
# tunnel hostname), because OAuth redirect URIs are minted from it.
# EH_GATEWAY_CLIENT_ID=
# EH_GATEWAY_CLIENT_SECRET=
# EH_GATEWAY_PUBLIC_URL=https://events.example.com
# EH_GATEWAY_SCOPES=
#
# Serves the endpoint with no auth on a non-loopback bind. Legitimate when the
# *network* authenticates — this deployment runs inside a ZeroTier mesh whose
# peers are all authenticated. Not legitimate on a public interface.
# EH_GATEWAY_ALLOW_INSECURE=1

# ── Per-source caps ────────────────────────────────────────────────────────────
# How many scored messages each source may send to the LLM.
#   -1  unlimited (the default since 2026-08-11)
#    0  drop this source entirely
#
# Capping here was losing whole sources silently. Every web sub-source shares
# one `web` bucket, so luma's 60 messages took all 30 slots under the old
# CAP_WEB=30 and erobay fetched 121 messages every run for weeks without
# producing a single event. Filtering now happens on the events page, which can
# only filter what actually got extracted.
#
# The cost moved to the LLM stage. Set a ceiling here to bound it globally, or
# per-source from /admin. The `event-harvester` CLI restores the old ceilings
# (50/50/30/30/30, total 150) for interactive runs regardless of these.
# CAP_DISCORD=-1
# CAP_TELEGRAM=-1
# CAP_GMAIL=-1
# CAP_SIGNAL=-1
# CAP_WEB=-1
# CAP_TOTAL=-1

# ── Defaults ───────────────────────────────────────────────────────────────────
DAYS_BACK=7

# ── Job queue ─────────────────────────────────────────────────────────────────
# Wall-clock ceiling per harvest job. Default 5400 (90 min). Raised from 30 min
# on 2026-08-13 after it killed a healthy run 13 batches from the finish: a cold
# message cache means re-scraping 33 web sources, and a local model at
# batch_size=5 is ~161 serialised calls. This is a function of your deployment's
# speed, not of the code.
# EH_JOB_TIMEOUT_SECONDS=5400
