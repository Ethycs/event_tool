# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
ENV/

# Environment / secrets
.env
# `.env` alone does not cover a backup, and a backup of .env is still .env.
# Added 2026-08-13 after `.env.bak-20260813` showed up as untracked-but-not-
# ignored, one `git add -A` away from being published.
.env.*
!.env.example
*.session
credentials.json
token.json
client_secret_*.json
# ticktick-py's OAuth2 cache holds a live access token. outputs/ticktick.py now
# pins it to data/.token-oauth, but the library default is `.token-oauth` in the
# CWD, so a stale one may still exist at the repo root. No leading slash here:
# this matches at any depth, which covers both.
.token-oauth

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Project
*.json.bak
*.bak
.pytest_cache/

# Message cache and watermarks
.message_cache.json
data/.message_cache.json
data/.watermarks.json
data/.event_fingerprints.json
data/.playwright_state.json
data/.chrome_profile/
data/.web_traces/
data/*

# Trained classifier models
classifiers/*.pkl

# Data artifacts
data/*.json
# ...but web_sources.json is the exception: it is the list of sites to
# harvest -- public URLs and scraping options, no message content and no
# credentials.  The blanket rule above exists for the files that DO hold
# private data (labels*.json carries ~11k real harvested messages, and the
# dot-prefixed caches/watermarks/fingerprints).  Sweeping the source list in
# with them meant the harvest config was untracked, and with no git remote on
# this repo it existed on exactly one disk.
!data/web_sources.json
data/eval_samples/
data/.message_cache.json

# pixi environments
.pixi
*.egg-info
pixi.lock

# UC extension build artifacts
ext/uc_extension/node_modules/
ext/uc_extension/dist/

# local noise (Claude Code + operator scratch)
.claude/settings.local.json
.ssh/
logs/
reports/
probe_out.txt
test.md
interview.py

# DVC pointers must stay visible even though the data they point at does not.
# The blanket `data/*` above swallows them, and `dvc add` refuses to create a
# pointer it cannot commit ("bad DVC file name ... is git-ignored").  The
# pointers carry md5 hashes only -- no message content -- and they are the only
# way a clone can `dvc pull` this data back from the lakeFS store.
!data/*.dvc
!data/.gitignore
